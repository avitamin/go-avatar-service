{
  "uid": "avatar-service-overview",
  "title": "Avatar Service Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["avatar-service", "observability"],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(up{job=~\"avatar-service-.*\"}, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(http_requests_total, route)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      },
      {
        "name": "interval",
        "type": "interval",
        "query": "1m,5m,15m,30m,1h",
        "current": {"text": "$__rate_interval", "value": "$__rate_interval"}
      }
    ]
  },
  "links": [
    {
      "title": "Jaeger server traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"jaeger\",\"queries\":[{\"service\":\"avatar-service-server\"}]}"
    },
    {
      "title": "Loki avatar logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{service_name=~\\\"avatar-service-.*\\\"}\"}]}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum by (route, method) (rate(http_requests_total{route=~\"$route\"}[$interval]))", "legendFormat": "{{method}} {{route}}"}
      ],
      "links": [
        {"title": "View server traces", "url": "/explore?left={\"datasource\":\"jaeger\",\"queries\":[{\"service\":\"avatar-service-server\"}]}"}
      ]
    },
    {
      "id": 2,
      "title": "5xx error ratio",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(http_requests_total{status=~\"5..\"}[$interval])) / clamp_min(sum(rate(http_requests_total[$interval])), 1)", "legendFormat": "5xx ratio"}
      ],
      "links": [
        {"title": "View error logs", "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{service_name=~\\\"avatar-service-.*\\\", severity_text=~\\\"ERROR|error\\\"}\"}]}"}
      ]
    },
    {
      "id": 3,
      "title": "p95 latency by route",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, route, method) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[$interval])))", "legendFormat": "{{method}} {{route}}"}
      ]
    },
    {
      "id": 4,
      "title": "In-flight requests",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (route, method) (http_inflight_requests{route=~\"$route\"})", "legendFormat": "{{method}} {{route}}"}
      ]
    },
    {
      "id": 5,
      "title": "Dependency health check errors",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum by (component, operation) (rate(avatar_dependency_operations_total{operation=~\".*Health|health_check|Ping\", status=\"error\"}[$interval]))", "legendFormat": "{{component}} {{operation}}"}
      ]
    },
    {
      "id": 6,
      "title": "Recent error logs",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "{service_name=~\"avatar-service-.*\", severity_text=~\"ERROR|error\"}"}
      ]
    }
  ]
}
